{
  "name": "@algoverse/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "nx": {
    "tags": [
      "scope:web"
    ],
    "targets": {
      "serve": {
        "command": "vite serve --config vite.config.ts"
      },
      "build": {
        "command": "vite build --config vite.config.ts"
      },
      "preview": {
        "command": "vite preview --config vite.config.ts"
      },
      "typecheck": {
        "command": "tsc --noEmit -p tsconfig.json"
      },
      "lint": {
        "command": "eslint src --ext .ts,.tsx --max-warnings 0"
      },
      "test": {
        "command": "vitest run"
      }
    }
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/three": "^0.184.1",
    "three": "^0.184.0"
  }
}
