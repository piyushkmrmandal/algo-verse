# =============================================================================
# AlgoVerse — .gitignore
# =============================================================================

# ── Node / npm / Yarn / pnpm ─────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.output/
storybook-static/

# ── Nx ───────────────────────────────────────────────────────────────────────
.nx/cache
.nx/workspace-data

# ── Vite ─────────────────────────────────────────────────────────────────────
*.local
vite.config.*.timestamp-*

# ── Environment / secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
*.pem
*.key
*.p12
*.pfx
secrets/
.secrets/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Test coverage & reports ───────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/
playwright-report/
test-results/
allure-results/
allure-report/
.vitest-cache/

# ── Java / Maven ──────────────────────────────────────────────────────────────
target/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
.mvn/wrapper/maven-wrapper.jar
# Maven local repo (if accidentally inside project)
.m2/

# ── IDE — IntelliJ IDEA ───────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

# ── IDE — VS Code ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
*.code-workspace

# ── IDE — Eclipse ─────────────────────────────────────────────────────────────
.classpath
.project
.settings/
.factorypath

# ── IDE — NetBeans ────────────────────────────────────────────────────────────
nbproject/private/
nbbuild/
nbdist/
nbactions.xml
nb-configuration.xml

# ── IDE — Vim / Emacs / generic ───────────────────────────────────────────────
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~
.#*
\#*\#

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon\r
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# ── Windows ───────────────────────────────────────────────────────────────────
Thumbs.db
Thumbs.db:encryptionKey
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# ── Linux ─────────────────────────────────────────────────────────────────────
*~

# ── Python (ai-service) ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
*.egg-info/
dist/
*.egg
pip-log.txt
pip-delete-this-directory.txt
.tox/
.hypothesis/

# ── Docker ────────────────────────────────────────────────────────────────────
.docker/
docker-compose.override.yml

# ── Terraform ─────────────────────────────────────────────────────────────────
infrastructure/**/.terraform/
infrastructure/**/*.tfstate
infrastructure/**/*.tfstate.*
infrastructure/**/*.tfvars
!infrastructure/**/*.tfvars.example
infrastructure/**/.terraform.lock.hcl
infrastructure/**/crash.log
infrastructure/**/crash.*.log
infrastructure/**/.terraformrc
infrastructure/**/terraform.rc
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ── Kubernetes / Helm ─────────────────────────────────────────────────────────
*.kubeconfig
kubeconfig
.helm/
charts/*.tgz

# ── Redis dump ────────────────────────────────────────────────────────────────
dump.rdb

# ── Database dumps ────────────────────────────────────────────────────────────
*.sql.gz
*.dump

# ── Misc ─────────────────────────────────────────────────────────────────────
*.bak
*.tmp
*.temp
*.orig
graphify-out/
.turbo/
.cache/
