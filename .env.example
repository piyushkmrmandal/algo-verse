# ============================================================
# AlgoVerse — Environment Variables Template
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ============================================================

# ──────────────────────────────────────────────────────────
# Database (PostgreSQL) — shared credentials
# ──────────────────────────────────────────────────────────
POSTGRES_USER=algoverse
POSTGRES_PASSWORD=secret
POSTGRES_DB=algoverse

# ──────────────────────────────────────────────────────────
# Per-service PostgreSQL URLs
# ──────────────────────────────────────────────────────────
AUTH_DB_URL=jdbc:postgresql://localhost:5432/auth_db
PROBLEM_DB_URL=jdbc:postgresql://localhost:5432/problem_db
SUBMISSION_DB_URL=jdbc:postgresql://localhost:5432/submission_db
EXECUTION_DB_URL=jdbc:postgresql://localhost:5432/execution_db
GAMIFICATION_DB_URL=jdbc:postgresql://localhost:5432/gamification_db
ANALYTICS_DB_URL=jdbc:postgresql://localhost:5432/analytics_db
COLLABORATION_DB_URL=jdbc:postgresql://localhost:5432/collaboration_db
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/notification_db
SYSDESIGN_DB_URL=jdbc:postgresql://localhost:5432/sysdesign_db
AI_DB_URL=postgresql+asyncpg://algoverse:secret@localhost:5432/ai_db

# ──────────────────────────────────────────────────────────
# MongoDB
# ──────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/problemdb

# ──────────────────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ──────────────────────────────────────────────────────────
# Elasticsearch (problem-service)
# ──────────────────────────────────────────────────────────
ELASTICSEARCH_URIS=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# ──────────────────────────────────────────────────────────
# Kafka
# ──────────────────────────────────────────────────────────
# Use localhost:29092 when running services outside Docker.
# Use kafka:9092 when running services inside Docker.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# ──────────────────────────────────────────────────────────
# JWT — RS256 (asymmetric). Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Set the full PEM content (replace newlines with \n).
# ──────────────────────────────────────────────────────────
JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...your private key here...\n-----END RSA PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...your public key here...\n-----END PUBLIC KEY-----

# ──────────────────────────────────────────────────────────
# OAuth2 Social Login
# Register apps at:
#   Google  → https://console.cloud.google.com
#   GitHub  → https://github.com/settings/developers
#   LinkedIn → https://www.linkedin.com/developers
# ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# ──────────────────────────────────────────────────────────
# AI Service (Ollama — open-source LLM, no API key needed)
# Install: https://ollama.ai  |  Run: ollama serve && ollama pull qwen2.5-coder:7b
# ──────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL=qwen2.5-coder:7b
PROBLEM_SERVICE_URL=http://localhost:8082/api/v1

# ──────────────────────────────────────────────────────────
# Notification Service feature flags
# ──────────────────────────────────────────────────────────
EMAIL_ENABLED=false
PUSH_ENABLED=false
